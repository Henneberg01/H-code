ƒ keep(p:⦃name:String,score:Number⦄)→Bool ↩ p·score>0;
ƒ label(p:⦃name:String,score:Number⦄)→String ↩ p·name;
≔nums←⟦-3,0,7,11⟧;
print(∑nums);
print(⤒(nums⇢(*2)));
print(⤒(nums⌕(>0)));
≔labels←⟦"a","bb","ccc"⟧;
print(⤒(labels⇢λs:s+"!"));
print(⤒(labels⌕λs:s!="bb"));
≔flags←⟦⊤,⊥,⊤⟧;
print(⤒(flags⌕λv:v));
≔people←⟦⦃name:"A",score:5⦄,⦃name:"B",score:0⦄⟧;
print(⤒(people⌕keep));
print(⤒(people⇢label));
≔nested←⟦⟦1,2⟧,⟦3⟧⟧;
print(⤒(nested⇢λxs:⌗xs));
≔empty:⟦Number⟧←⟦⟧;
print(∑empty);
print(⤒(empty⇢(*2)));
