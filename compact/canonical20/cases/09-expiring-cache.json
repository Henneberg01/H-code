      "id": "hit-expire-boundary",
      "events": [
        {
          "at": 0,
          "key": "a",
          "op": "set",
          "ttl": 10,
          "value": "A"
        },
        {
          "at": 0,
          "key": "a",
          "op": "get",
          "ttl": 0,
          "value": ""
        },
        {
          "at": 9,
          "key": "a",
          "op": "get",
          "ttl": 0,
          "value": ""
