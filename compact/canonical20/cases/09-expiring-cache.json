{
  "id": "09-expiring-cache",
  "acceptance": "fake clock, set/get/expire, prevent stale reads and bounded memory",
  "originalRegistryGitBlobSha": "46653ef90ffb3e420fba4ddfbfac3c4cfd57f3b3",
  "fakeClock": "explicit monotonic at milliseconds from test event stream",
  "maxEntries": 8,
  "expiryBoundary": "valid exactly while at < setAt + ttl",
  "eviction": "FIFO, replacements move to end",
