{
  "id": "01-calculator-cli",
  "acceptance": "stdin expressions for +,-,*,/ with invalid division; stable stdout/stderr and exit status",
  "registryBlobSha": "46653ef90ffb3e420fba4ddfbfac3c4cfd57f3b3",
  "stdinProtocol": "one finite arithmetic expression per invocation; Unicode whitespace allowed; no eval/variables",
  "numericGrammar": "(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?|\\.[0-9]+, optional exponent [eE][+-]?[0-9]+",
  "operators": "left-associative +,-,*,/; parentheses and unary +/-; multiplication binds before addition",
  "errorContract": "HCODE_ERROR: <safe deterministic message>\\n; exit 2; stdout empty",
  "maxStdinUtf8Bytes": 65536,
