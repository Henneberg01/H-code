{
  "name": "h-code-language",
  "version": "0.0.2",
  "private": true,
  "type": "module",
  "description": "H-Code M1 reference interpreter, symbol linker and offline library contract verification",
  "scripts": {
    "test": "node --test prototype/test/*.test.mjs",
    "demo": "node prototype/bin/hcode.mjs run examples/user_symbols.hc --lock hcode.lock.json",
    "check": "node prototype/bin/hcode.mjs check examples/user_symbols.hc --lock hcode.lock.json",
    "studio": "node studio/server.mjs",
    "studio:test": "node --test studio/test/*.test.mjs",
    "bench": "node studio/benchmark.mjs",
    "release:check": "node scripts/release-check.mjs",
    "phase1:measure": "node scripts/phase1-metrics.mjs",
    "phase1:test": "node --test scripts/test/*.test.mjs"
  },
  "engines": {
    "node": ">=20"
  }
}
