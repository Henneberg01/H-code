{
  "name": "h-code-language",
  "version": "0.0.2",
  "private": true,
  "type": "module",
  "description": "H-Code M1 reference interpreter, symbol linker and offline library contract verification",
  "scripts": {
    "test": "node --test prototype/test/*.test.mjs",
    "demo": "node prototype/bin/hcode.mjs run examples/user_symbols.hc --lock hcode.lock.json",
    "check": "node prototype/bin/hcode.mjs check examples/user_symbols.hc --lock hcode.lock.json",
    "studio": "node studio/server.mjs",
    "studio:test": "node --test studio/test/*.test.mjs",
    "bench": "node studio/benchmark.mjs",
    "release:check": "node scripts/release-check.mjs",
    "phase1:measure": "node scripts/phase1-metrics.mjs",
    "phase1:test": "node --test scripts/test/*.test.mjs",
    "compact:measure": "node scripts/compact-metrics.mjs",
    "compact:test": "node --test scripts/test/compact-*.test.mjs",
    "compact:ts-parity": "node scripts/compact-ts-parity.mjs",
    "m13:measure": "node scripts/m13-compare.mjs",
    "m14:measure": "node scripts/m14-compare.mjs",
    "m15:measure": "node scripts/m15-compare.mjs",
    "benchmark20:status": "node scripts/canonical20-coverage.mjs",
    "benchmark20:test": "node --test scripts/test/canonical20-coverage.test.mjs scripts/test/canonical20-calculator-idiomatic.test.mjs",
    "benchmark20:strict": "node scripts/canonical20-coverage.mjs --require-complete",
    "m12:measure": "node scripts/m12-records-compare.mjs",
    "m12:json-measure": "node scripts/m12-typed-json-compare.mjs",
    "benchmark20:verify05": "node scripts/canonical20-verify-05.mjs",
    "benchmark20:verify02": "node scripts/canonical20-verify-02.mjs",
    "benchmark20:verify10": "node scripts/canonical20-verify-10.mjs",
    "benchmark20:verify03": "node scripts/canonical20-verify-03.mjs",
    "benchmark20:verify04": "node scripts/canonical20-verify-04.mjs",
    "benchmark20:csv-idiomatic": "node --experimental-strip-types scripts/canonical20-csv-idiomatic.mjs",
    "benchmark20:verify01": "node scripts/canonical20-verify-01.mjs",
    "benchmark20:calc-idiomatic": "node scripts/canonical20-arith-idiomatic.mjs",
    "benchmark20:http-contract": "node --experimental-strip-types --test scripts/canonical20-http-contract.test.mjs",
    "benchmark20:verify06": "node --experimental-strip-types --test scripts/canonical20-verify-06.test.mjs",
    "benchmark20:batch08": "node --test scripts/canonical20-http-batch-compiler.test.mjs",
    "benchmark20:verify08": "node --experimental-strip-types --test scripts/canonical20-verify-08.test.mjs",
    "benchmark20:verify07": "node --experimental-strip-types --test scripts/canonical20-verify-07.test.mjs",
    "benchmark20:verify09": "node --experimental-strip-types --test scripts/canonical20-verify-09.test.mjs",
    "benchmark20:verify11": "node --experimental-strip-types --test scripts/canonical20-verify-11.test.mjs",
    "benchmark20:contract12": "node --experimental-strip-types --test scripts/canonical20-contract-12.test.mjs",
    "benchmark20:serve12b1": "node --test scripts/m19-http-serve-b1.test.mjs",
    "benchmark20:state12b2a": "node --test scripts/m19-http-state-b2a.test.mjs",
    "benchmark20:state12b2b": "node --test scripts/m19-http-state-b2b.test.mjs",
    "benchmark20:state12b2c1": "node --test scripts/m19-http-state-b2c1.test.mjs",
    "benchmark20:state12b2c2": "node --test scripts/m19-http-state-b2c2.test.mjs",
    "benchmark20:state12b2c2-http": "node --test scripts/m19-http-state-b2c-red.test.mjs",
