# Keep benchmark and H-Code source bytes identical on Windows and Linux.
# SHA-locked source comparisons require LF, not platform-dependent CRLF.
*.hc text eol=lf
*.hcs text eol=lf
*.ts text eol=lf
*.json text eol=lf

# Preserve BOM, LF, CRLF and literal newlines inside SHA-locked CSV files.
data/canonical04/*.csv -text

# Canonical07 exact-byte fixtures contain BOM, LF and literal CRLF.
# Never allow Windows core.autocrlf to rewrite a frozen evidence source.
compact/canonical20/cases/07-*.csv -text
