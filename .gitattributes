# Keep benchmark and H-Code source bytes identical on Windows and Linux.
# SHA-locked source comparisons require LF, not platform-dependent CRLF.
*.hc text eol=lf
*.hcs text eol=lf
*.ts text eol=lf
*.json text eol=lf

# Preserve BOM, LF, CRLF and literal newlines inside SHA-locked CSV files.
data/canonical04/*.csv -text

# Canonical07 exact-byte fixtures contain BOM, LF and literal CRLF.
# Never allow Windows core.autocrlf to rewrite a frozen evidence source.
compact/canonical20/cases/07-*.csv -text

# M19.13 real-Chromium DOM fixture and probe are Git-blob-SHA-locked.
# Force LF on Windows too, without rewriting unrelated historical fixtures.
compact/canonical20/programs/13-form-validation-ui.html text eol=lf
scripts/m19-browser-ui-probe.js text eol=lf

# Native H-Code and TypeScript todo source, HTML and neutral Chrome probe are
# benchmark candidates. Keep LF identical on Windows and Ubuntu for future locks.
compact/canonical20/programs/14-*.html text eol=lf
compact/canonical20/programs/14-*.hc text eol=lf
compact/canonical20/idiomatic/14-*.ts text eol=lf
scripts/m19-todo-browser-probe.js text eol=lf
